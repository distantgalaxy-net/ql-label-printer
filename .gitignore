# Python caches
__pycache__/
*.pyc
# Runtime data on the NAS: saved details, presets (contains personal info)
data/settings.json
data/settings.json.tmp
# Optional password hash and the login-cookie key: never commit
data/auth.json
data/auth.json.tmp
data/secret.key
# Custom icons are personal; keep the folder only
data/icons/*
!data/icons/.keep
